{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "supabase": {
      "type": "local",
      "command": ["npx", "-y", "@supabase/mcp-server-supabase@latest"],
      "environment": {
         "SUPABASE_ACCESS_TOKEN": "",
         "SUPABASE_PROJECT_REF": ""
      }
    },
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@github/mcp-server@latest"],
      "environment": {
         "GITHUB_TOKEN": ""
      }
    }
  }
}
